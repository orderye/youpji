# 本地/开发环境变量（复制为 .env）
DATABASE_URL=postgres://youpji:youpji_dev@127.0.0.1:5433/youpji
REDIS_URL=redis://127.0.0.1:6380
BIND=0.0.0.0:8081
JWT_SECRET=dev-secret-change-me
# APP_ENV=production 时启动自检会拒绝弱 JWT_SECRET 与 CORS_ORIGINS=*
APP_ENV=development
AI_BASE_URL=
AI_API_KEY=
OLLAMA_URL=http://127.0.0.1:11434
# 高德 Web 服务 Key：填入后规划使用真实驾车路网矩阵（Redis 缓存 30 天）；
# 留空则降级为直线距离×1.3，并在响应 warnings 中返回 distance_estimated
AMAP_KEY=
CORS_ORIGINS=*
RUST_LOG=info,sqlx=warn
